# NotAfter configuration. Copy to .env and fill in.
# .env is git-ignored: it is the only place secrets live.

# --- Core ------------------------------------------------------------------
# The public URL of this app. It appears in emails, Teams cards and calendar
# invites, so it must be the hostname people can actually open.
BASE_URL=https://noafter.example.org

# Signs CSRF tokens. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Leave as-is for the container: /data is the named volume.
DATABASE_URL=sqlite:////data/notafter.db

LOG_LEVEL=INFO

# --- Authentication --------------------------------------------------------
# cloudflare = validate the Cf-Access-Jwt-Assertion JWT on every request.
# dev        = trust an X-Dev-User header. Local development only.
AUTH_MODE=cloudflare

# The "<team>" in https://<team>.cloudflareaccess.com
CF_ACCESS_TEAM=example

# The Application Audience (AUD) tag of the Cloudflare Access application
# that sits in front of this hostname.
CF_ACCESS_AUD=

# Everyone who passes Access can view. Only these addresses can change
# anything. Comma-separated.
EDITOR_EMAILS=first.editor@example.org,second.editor@example.org

# --- Email -----------------------------------------------------------------
# resend = post to the Resend API. smtp = talk to a mail server.
EMAIL_PROVIDER=resend

# The address every message comes from, on a domain verified in Resend. It is
# also the ORGANIZER of every calendar invite, so use a real mailbox.
EMAIL_FROM=no-after@example.org
EMAIL_FROM_NAME=No After

# From the Resend dashboard. Needs outbound access to api.resend.com.
RESEND_API_KEY=

# --- Email over SMTP (only when EMAIL_PROVIDER=smtp) -------------------------
# Resend also runs an SMTP relay, and it is worth knowing why you might prefer
# it: over SMTP a calendar invite is sent as a text/calendar alternative part,
# which is what makes Outlook and Google Calendar show accept and decline
# buttons. Resend's HTTP API cannot express that, so there an invite arrives
# as an .ics attachment instead. Same account, same deliverability:
#
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=<your RESEND_API_KEY>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on 587, or set SMTP_USE_TLS=true for implicit TLS on 465.
SMTP_USE_STARTTLS=true
SMTP_USE_TLS=false

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
DAILY_RUN_TIME=07:00
TIMEZONE=Europe/Amsterdam

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=262144
UPLOAD_RATE_LIMIT=20/hour
SETTINGS_RATE_LIMIT=30/hour

# The Microsoft Teams Workflows webhook URL is NOT set here: it is entered on
# the settings page, so that it can be rotated without a redeploy.
